fg="#c0caf5"
bg="#1a1b26"

bg_dark="#16161e"
fg_dark="#a9b1d6"

black="#15116e"
bg_highlight="#292e42"

set -g popup-style "fg=#c0caf5,bg=#1a1b26"
set -g popup-border-style "fg=#a9b1d6,bg=#1a1b26"
set -g tree-mode-border-style "fg=#a9b1d6,bg=#1a1b26"

# tmux 3.8 UI palette for menus, popups, and built-in modes.
set -g dark-theme-black "${bg_dark}"
set -g dark-theme-white "${fg}"
set -g dark-theme-light-grey "${fg_dark}"
set -g dark-theme-dark-grey "${bg_highlight}"
set -g dark-theme-red "#f7768e"
set -g dark-theme-green "#9ece6a"
set -g dark-theme-yellow "#e0af68"
set -g dark-theme-blue "#7aa2f7"
set -g dark-theme-cyan "#7dcfff"
set -g dark-theme-magenta "#bb9af7"
