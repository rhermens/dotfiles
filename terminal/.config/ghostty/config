# font-family = Iosevka Nerd Font Mono
font-family = Lilex Nerd Font Mono
adjust-cell-height = 2
theme = TokyoNight Night
alpha-blending = linear-corrected
maximize = true

background-image = ~/dotfiles/img/bg.jpg
background-image-opacity = 0.0005
background-image-fit = cover

window-show-tab-bar = never
window-theme = ghostty
window-decoration = none

app-notifications = no-clipboard-copy

gtk-titlebar = true
gtk-toolbar-style = flat

clipboard-read = allow
clipboard-write = allow

# Make the left Option key send Alt (ESC) sequences instead of special
# characters, so Option+H reaches apps as Alt+H (e.g. nvim snacks picker
# toggle_hidden). Right Option still types special characters.
macos-option-as-alt = left

# Keep Linux-style clipboard shortcuts available on macOS.
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
